{
  "name": "obsidian-plugin-stats-badge",
  "version": "0.1.0",
  "description": "Download badges and history charts for Obsidian community plugins, as a GitHub Action",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/action.ts -o dist --minify",
    "test": "tsc --noEmit && node --test --experimental-strip-types test/*.test.ts",
    "cli": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  }
}
